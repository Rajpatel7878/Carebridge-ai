{
  "name": "carebridge-ai-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "CareBridge AI — Frontend web application (Team ALPHA | Future Health Challenge)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,js,ts,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,js,ts,html}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "axios": "^1.21.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
