# =============================================================================
# CareBridge AI — Frontend Environment Configuration Example
# Copy this file to frontend/.env for local overrides.
# NEVER commit frontend/.env to version control.
# =============================================================================

# Same-origin API path routed through Vite (dev) or Nginx (Docker/prod) so
# HttpOnly SameSite cookies and CSRF tokens work seamlessly.
# Override to an explicit origin (e.g. https://api.example.org/api) only when
# hosting the API on a separate domain with matching CORS/cookie settings.
VITE_API_BASE_URL=/api

# Optional override for the Vite dev server /api proxy target
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
