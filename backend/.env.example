# =============================================================================
# CareBridge AI — Backend Environment Configuration Example
# Copy this file to backend/.env and fill in your local values.
# NEVER commit backend/.env or real secrets to version control.
# =============================================================================

# Application metadata
APP_NAME=CareBridge AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api

# Database connection string
# Leave empty to automatically fall back to local SQLite (sqlite:///./carebridge_dev.db).
# For PostgreSQL: postgresql+psycopg://<user>:<password>@localhost:5432/carebridge_ai
DATABASE_URL=

# Security, JWT & Session Cookies
# Required outside local development/test (>= 32 chars).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=carebridge-ai
JWT_AUDIENCE=carebridge-ai-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_REFRESH_EXPIRE_HOURS=12

# HttpOnly cookie + CSRF settings
ACCESS_COOKIE_NAME=cb_access_token
REFRESH_COOKIE_NAME=cb_refresh_token
CSRF_COOKIE_NAME=cb_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SAMESITE=lax
# Leave empty to auto-enable Secure=true in production (HTTPS) and false in local HTTP dev
COOKIE_SECURE=
COOKIE_DOMAIN=

# Authentication rate limiting (per-process sliding window)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=15
REGISTER_RATE_LIMIT_IP_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Initial Admin CLI (optional env-driven provisioning; otherwise interactive prompt)
# Run: python -m app.cli.create_admin
# ADMIN_FULL_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# AI provider key (reserved for later phases)
GEMINI_API_KEY=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
