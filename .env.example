# =============================================================================
# CareBridge AI — Root Environment Configuration Example
# Copy this file to .env and fill in real values for local or Docker runs.
# NEVER commit .env or real secrets to version control.
# =============================================================================

# --- Application ---
APP_NAME=CareBridge AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api

# --- Database ---
# Leave empty in local development to use the automatic SQLite fallback
# (backend/carebridge_dev.db), or provide a PostgreSQL connection URL:
# Example: postgresql+psycopg://<user>:<password>@localhost:5432/carebridge_ai
DATABASE_URL=

# --- PostgreSQL Container Settings (used by docker-compose.yml only) ---
POSTGRES_DB=carebridge_ai
POSTGRES_USER=carebridge
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Security, JWT & Session Cookies ---
# Required outside local development/test (>= 32 chars).
# Generate a strong key with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=carebridge-ai
JWT_AUDIENCE=carebridge-ai-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_REFRESH_EXPIRE_HOURS=12

# HttpOnly session cookies + double-submit CSRF protection
ACCESS_COOKIE_NAME=cb_access_token
REFRESH_COOKIE_NAME=cb_refresh_token
CSRF_COOKIE_NAME=cb_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SAMESITE=lax
# Leave empty to auto-enable Secure=true in production (HTTPS) and false in local HTTP dev
COOKIE_SECURE=
COOKIE_DOMAIN=

# --- Authentication Rate Limiting ---
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=15
REGISTER_RATE_LIMIT_IP_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Initial Admin Provisioning (CLI only — never leave ADMIN_PASSWORD persisted) ---
# Run inside backend/: python -m app.cli.create_admin
# ADMIN_FULL_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Private Patient Report Upload Storage ---
# Defaults to backend/uploads/medical_reports (never publicly served; gitignored)
UPLOAD_STORAGE_DIR=
MAX_REPORT_UPLOAD_MB=10

# --- AI Integration (Google Gemini — reserved for later phases) ---
GEMINI_API_KEY=

# --- Backend Server & CORS ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=5173
# Same-origin /api path works automatically with Vite dev proxy and Docker Nginx
VITE_API_BASE_URL=/api
