# Environment & Secrets (NEVER commit real secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
build/
out/
.vite/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
coverage/

# Databases (local SQLite fallback & dumps)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sql.gz
*.dump

# Logs
logs/
*.log

# Temporary Uploads & Runtime Files
uploads/
backend/uploads/
tmp/
temp/
.tmp/
*.tmp
*.bak

# IDE & Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Unselected / Scratch Artifacts
Unselected files/
